<!DOCTYPE html>
<html lang="en">
    <head>
        <%- include('../partials/head', { seo: typeof seo !== 'undefined' ? seo : undefined }) %>
    </head>
    <body
        class="font-sans antialiased bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100 selection:bg-brand-400/30"
    >

	<%- include('../partials/header') %>

            <%- include('../partials/breadcrumbs', { breadcrumbs: typeof breadcrumbs !== 'undefined' ? breadcrumbs : [] }) %>

            <main
                class="relative z-10 flex-1 mx-auto w-full max-w-7xl px-6 lg:px-8"
            >
                <section class="pt-12 pb-10 text-center">
                    <div
                        class="mb-5 inline-flex items-center gap-2 rounded-full border border-brand-400/20 bg-brand-400/10 px-4 py-2 text-xs font-medium tracking-[0.2em] text-brand-700 uppercase dark:text-brand-200"
                    >
                        <% if (typeof heroIcon !== "undefined" && heroIcon) { %><%- heroIcon %><% } %><%= heroBadge %>
                    </div>
                    <h2
                        class="text-5xl font-black leading-none tracking-tight text-slate-950 dark:text-white sm:text-6xl lg:text-7xl"
                    >
                        <span class="inline-flex flex-wrap items-center justify-center gap-x-3">
                            <% if (typeof heroHeadingIcon !== "undefined" && heroHeadingIcon) { %><%- heroHeadingIcon %><% } %><%= heroHeading %>
                            <span
                                class="bg-gradient-to-r from-brand-500 via-cyan-500 to-fuchsia-500 bg-clip-text text-transparent"
                            >
                                <%= heroHighlight %>
                            </span>
                        </span>
                    </h2>
                    <p
                        class="mx-auto mt-5 max-w-xl text-lg leading-8 text-slate-600 dark:text-slate-300"
                    >
                        <%= heroSubtitle %>
                    </p>
                </section>

                <section class="pb-16">
                    <% if (showCategoryFilter && filterCategories.length && !isArchive) { %>
                    <div class="mb-8 flex flex-wrap justify-center gap-2">
                        <a
                            href="/"
                            class="rounded-full border px-4 py-2 text-sm font-semibold transition-all <%= !activeCategory ? 'border-transparent bg-slate-950 text-white dark:bg-white dark:text-slate-950' : 'border-slate-200 bg-white/80 text-slate-700 hover:bg-brand-50 hover:border-brand-300 hover:text-brand-700 dark:border-white/10 dark:bg-white/5 dark:text-slate-300' %>"
                        >
                            All
                        </a>
                        <% filterCategories.forEach(function (cat) { %>
                        <a
                            href="/browse/<%= cat.id %>"
                            class="rounded-full border px-4 py-2 text-sm font-semibold transition-all <%= activeCategory && activeCategory.id === cat.id ? 'border-transparent bg-slate-950 text-white dark:bg-white dark:text-slate-950' : 'border-slate-200 bg-white/80 text-slate-700 hover:bg-brand-50 hover:border-brand-300 hover:text-brand-700 dark:border-white/10 dark:bg-white/5 dark:text-slate-300' %>"
                        >
                            <%= cat.name %>
                        </a>
                        <% }); %>
                    </div>
                    <% } %>
                    <div
                        class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3"
                    >
                        <% products.forEach(product => { %>
                        <article
                            data-product-card
                            data-category-id="<%= product.category_id || '' %>"
                            class="group flex flex-col overflow-hidden rounded-[2rem] border border-brand-200/60 bg-gradient-to-br from-blue-50 via-white to-cyan-50/80 shadow-panelLight transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-brand-500/10 dark:border-white/10 dark:from-blue-950/60 dark:via-slate-900/80 dark:to-cyan-950/40 dark:shadow-panelDark"
                        >
                            <a
                                href="/product/<%= product.id %>"
                                class="relative block overflow-hidden"
                                aria-label="View <%= product.name %>"
                            >
                                <img
                                    src="<%= product.image || defaultThumbnail %>"
                                    alt="<%= product.name %> Thumbnail"
                                    onerror="this.onerror=null;this.src='/images/placeholder.svg';"
                                    class="h-53 w-full object-top transition-transform duration-500 group-hover:scale-105"
                                />
                                <div
                                    class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                                ></div>
                                <% if (parseFloat(product.price) === 0) { %>
                                <span
                                    class="absolute top-3 left-3 rounded-full border border-emerald-300/40 bg-emerald-500/90 px-3 py-1 text-xs font-bold uppercase tracking-wider text-white shadow-md backdrop-blur-sm"
                                >
                                    Free
                                </span>
                                <% } %>
                                <% if (product.sticky) { %>
                                <span
                                    class="absolute top-3 right-3 inline-flex items-center gap-1 rounded-full border border-amber-300/40 bg-amber-500/90 px-3 py-1 text-xs font-bold uppercase tracking-wider text-white shadow-md backdrop-blur-sm"
                                >
                                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l2.9 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 7.1-1.01z" /></svg>
                                    Featured
                                </span>
                                <% } %>
                            </a>

                            <div
                                class="flex flex-col flex-grow p-6 gap-4 bg-gradient-to-br from-blue-600/90 via-blue-700/90 to-cyan-700/90 dark:from-blue-900/80 dark:via-blue-950/90 dark:to-cyan-950/80"
                            >
                                <div class="flex flex-col gap-2">
                                    <% if (product.category_name) { %>
                                    <div>
                                        <a
                                            href="/category/<%= product.category_id %>"
                                            class="inline-flex items-center gap-1 rounded-full border border-white/25 bg-white/15 px-2.5 py-1 text-xs font-semibold text-white backdrop-blur-sm transition hover:bg-white hover:text-blue-700"
                                        >
                                            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" /><path d="M6 6h.008" /></svg>
                                            <%= product.category_name %>
                                        </a>
                                    </div>
                                    <% } %>
                                    <h3
                                        class="text-lg font-bold leading-snug text-white transition-colors group-hover:text-cyan-200"
                                    >
                                        <a href="/product/<%= product.id %>" class="hover:underline">
                                            <%= product.name %>
                                        </a>
                                    </h3>
                                    <p
                                        class="text-sm leading-relaxed text-blue-100/80 line-clamp-3"
                                    >
                                        <%= product.description %>
                                    </p>
                                    <% if (product.tags && product.tags.length) { %>
                                    <div class="flex flex-wrap gap-1.5 pt-1">
                                      <% product.tags.slice(0, 4).forEach(function (tag) { %>
                                      <a href="/tag/<%= tag.id %>" class="inline-flex items-center rounded-full border border-white/25 bg-white/10 px-2 py-0.5 text-[11px] font-medium text-white/90 backdrop-blur-sm transition hover:bg-white hover:text-blue-700">
                                        #<%= tag.name %>
                                      </a>
                                      <% }); %>
                                    </div>
                                    <% } %>
                                </div>

                                <div class="flex-grow"></div>

                                <div
                                    class="flex items-center justify-between border-t border-white/10 pt-4"
                                >
                                    <% if (parseFloat(product.price) === 0) { %>
                                    <span
                                        class="text-sm font-semibold text-emerald-300"
                                    >
                                        Free
                                    </span>
                                    <% } else { %>
                                    <div class="flex flex-col leading-none">
                                        <span
                                            class="text-xs font-medium text-blue-200/70 uppercase tracking-wider"
                                            >Price</span
                                        >
                                        <span
                                            class="text-2xl font-black tracking-tight text-white"
                                        >
                                            $<%= product.price %>
                                        </span>
                                    </div>
                                    <% } %>

                                    <a
                                        href="/product/<%= product.id %>"
                                        class="inline-flex items-center gap-1.5 rounded-full bg-white/15 border border-white/20 backdrop-blur-sm px-5 py-2.5 text-sm font-semibold text-white shadow-md transition-all duration-200 hover:scale-[1.06] hover:bg-white hover:text-blue-700"
                                    >
                                        View Details
                                        <svg
                                            width="13"
                                            height="13"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2.5"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            class="transition-transform duration-200 group-hover:translate-x-0.5"
                                        >
                                            <path
                                                d="M5 12h14M12 5l7 7-7 7"
                                            />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </article>
                        <% }) %>
                    </div>
                </section>

                <% if (pagination.totalPages > 1) { %>
                <section class="pb-16">
                    <nav
                        class="flex justify-center items-center gap-2"
                        aria-label="Pagination"
                    >
                        <% const prevPage = pagination.currentPage - 1; %>
                        <a
                            href="<%= prevPage === 1 ? (basePath || '/') : basePath + '/page/' + prevPage + '/' %>"
                            class="inline-flex items-center gap-1 rounded-full border px-4 py-2 text-sm font-semibold transition-all <%
                                if (!pagination.hasPreviousPage) { %>
                                pointer-events-none border-slate-100 bg-slate-50 text-slate-300 dark:border-white/5 dark:bg-white/5 dark:text-slate-600
                                <% } else { %>
                                border-slate-200 bg-white/80 text-slate-700 hover:bg-brand-50 hover:border-brand-300 hover:text-brand-700 dark:border-white/10 dark:bg-white/5 dark:text-slate-300
                            <% } %>"
                        >
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M19 12H5M12 5l-7 7 7 7" />
                            </svg>
                            Prev
                        </a>

                        <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                        <a
                            href="<%= i === 1 ? (basePath || '/') : basePath + '/page/' + i + '/' %>"
                            class="inline-flex h-9 w-9 items-center justify-center rounded-full border text-sm font-semibold transition-all <%
                                if (i === pagination.currentPage) { %>
                                pointer-events-none border-transparent bg-slate-950 text-white dark:bg-white dark:text-slate-950
                                <% } else { %>
                                border-slate-200 bg-white/80 text-slate-700 hover:bg-brand-50 hover:border-brand-300 hover:text-brand-700 dark:border-white/10 dark:bg-white/5 dark:text-slate-300
                            <% } %>"
                        >
                            <%= i %>
                        </a>
                        <% } %>

                        <a
                            href="<%= basePath + '/page/' + (pagination.currentPage + 1) + '/' %>"
                            class="inline-flex items-center gap-1 rounded-full border px-4 py-2 text-sm font-semibold transition-all <%
                                if (!pagination.hasNextPage) { %>
                                pointer-events-none border-slate-100 bg-slate-50 text-slate-300 dark:border-white/5 dark:bg-white/5 dark:text-slate-600
                                <% } else { %>
                                border-slate-200 bg-white/80 text-slate-700 hover:bg-brand-50 hover:border-brand-300 hover:text-brand-700 dark:border-white/10 dark:bg-white/5 dark:text-slate-300
                            <% } %>"
                        >
                            Next
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M5 12h14M12 5l7 7-7 7" />
                            </svg>
                        </a>
                    </nav>
                </section>
                <% } %>
            </main>

	    <%- include('../partials/footer') %>
        </div>

    </body>
</html>
