<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard — Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link href="/css/app.css" rel="stylesheet" />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased">
    <div class="flex min-h-screen">

      <%- include('partials/sidebar') %>

      <div class="flex-1 flex flex-col min-w-0">
        <header
          class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 shrink-0"
        >
          <div>
            <h1 class="text-base font-semibold text-slate-900">Products</h1>
            <p class="text-xs text-slate-500">Manage your digital products</p>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <form method="GET" action="/admin/dashboard" class="flex items-center gap-2">
              <% if (activeCategory) { %><input type="hidden" name="category" value="<%= activeCategory %>" /><% } %>
              <label for="product-search" class="sr-only">Search products</label>
              <input
                type="search"
                id="product-search"
                name="q"
                value="<%= q %>"
                placeholder="Search name or ID"
                class="px-3 py-2 text-sm text-slate-700 bg-white border border-slate-300 rounded-lg shadow-input focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition"
              />
              <button
                type="submit"
                class="inline-flex items-center gap-1 px-3 py-2 text-sm font-semibold text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition"
              >
                Search
              </button>
              <% if (q) { %>
              <a href="/admin/dashboard" class="text-xs text-slate-500 hover:text-slate-700">Clear</a>
              <% } %>
            </form>
            <label for="category-filter" class="sr-only">Filter by category</label>
            <select
              id="category-filter"
              onchange="if(this.value){location.href='/admin/dashboard?category='+encodeURIComponent(this.value)+'<%= q ? "&q=" + encodeURIComponent(q) : "" %>';}else{location.href='/admin/dashboard<%= q ? "?q=" + encodeURIComponent(q) : "" %>';}"
              class="px-3 py-2 text-sm text-slate-700 bg-white border border-slate-300 rounded-lg shadow-input focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition"
            >
              <option value="" <%= activeCategory === '' ? 'selected' : '' %>>All categories</option>
              <option value="uncategorized" <%= activeCategory === 'uncategorized' ? 'selected' : '' %>>Uncategorized</option>
              <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>" <%= activeCategory === cat.id ? 'selected' : '' %>><%= cat.name %></option>
              <% }) %>
            </select>
            <a
              href="/admin/products/add"
              class="inline-flex items-center gap-2 px-4 py-2 bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold rounded-lg shadow-sm transition-colors duration-150"
            >
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 4.5v15m7.5-7.5h-15"
              />
            </svg>
            Add Product
            </a>
          </div>
        </header>

        <main class="flex-1 p-6">

          <% if (typeof emailReady !== 'undefined' && !emailReady) { %>
          <div class="mb-6 flex items-start gap-3 rounded-lg border border-amber-200 bg-amber-50 p-4">
            <svg class="w-5 h-5 text-amber-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-amber-800">Email is not configured</p>
              <p class="text-sm text-amber-700 mt-0.5">
                Purchase receipt emails will not be sent until you set a "From" address and a delivery method.
                Sales and downloads still work normally.
              </p>
              <a href="/admin/settings" class="inline-flex items-center gap-1 mt-2 text-sm font-semibold text-amber-800 hover:text-amber-900 underline">
                Configure email in Settings
              </a>
            </div>
          </div>
          <% } %>

          <div
            id="toast-notification"
            class="fixed top-5 right-5 z-50 w-full max-w-sm hidden"
            role="alert"
          >
            <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-slate-200 shadow-card">
              <div
                class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center shrink-0"
              >
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4.5 12.75l6 6 9-13.5"
                  />
                </svg>
              </div>
              <div class="flex-1 min-w-0 pt-0.5">
                <p class="text-sm font-semibold text-slate-900">
                  Product saved
                </p>
                <p
                  id="toast-message"
                  class="text-sm text-slate-500 truncate"
                ></p>
              </div>
            </div>
          </div>

          <div
            id="products-view-container"
            class="bg-white rounded-xl border border-slate-200 shadow-card overflow-hidden <% if (totalProducts === 0) { %>hidden<% } %>"
          >
            <div
              class="px-6 py-4 border-b border-slate-100 flex items-center justify-between"
            >
              <h2 class="text-sm font-semibold text-slate-900">
                <%= (activeCategory || q) ? 'Filtered Products' : 'All Products' %>
                <span
                  class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600"
                >
                  <%= totalProducts %>
                </span>
              </h2>
              <% if (reorderEnabled) { %>
              <span class="text-xs text-slate-400">Drag rows to reorder the shop</span>
              <% } else { %>
              <span class="text-xs text-slate-400">Clear the filter to reorder</span>
              <% } %>
            </div>
            <div id="products-table-container" class="overflow-x-auto">
              <table class="w-full text-left">
                <thead>
                  <tr class="border-b border-slate-100">
                    <th class="px-3 py-3 w-10">
                      <span class="sr-only">Reorder</span>
                    </th>
                    <th
                      class="px-6 py-3 text-xs font-semibold uppercase tracking-wider text-slate-400"
                    >
                      Name
                    </th>
                    <th
                      class="px-6 py-3 text-xs font-semibold uppercase tracking-wider text-slate-400"
                    >
                      Price
                    </th>
                    <th
                      class="px-6 py-3 text-xs font-semibold uppercase tracking-wider text-slate-400"
                    >
                      Short Text
                    </th>
                    <th
                      class="px-6 py-3 text-xs font-semibold uppercase tracking-wider text-slate-400"
                    >
                      Actions
                    </th>
                  </tr>
                </thead>
                <tbody
                  id="products-table-body"
                  class="divide-y divide-slate-50"
                  data-start-index="<%= startIndex %>"
                  data-reorder-enabled="<%= reorderEnabled ? 'true' : 'false' %>"
                >
                  <% products.forEach(product => { %>
                    <%- include('partials/product-row', { product: product, reorderEnabled: reorderEnabled }) %>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>

          <% if (pagination.totalPages > 1) { %>
          <nav class="mt-6 flex items-center justify-between gap-4" aria-label="Pagination">
            <p class="text-xs text-slate-500">
              Page <%= pagination.currentPage %> of <%= pagination.totalPages %>
              <span class="mx-1">·</span><%= totalProducts %> products
            </p>
            <div class="flex items-center gap-1.5">
              <% const prevPage = pagination.currentPage - 1; %>
              <a
                href="<%= (prevPage <= 1 ? '/admin/dashboard' : '/admin/dashboard/page/' + prevPage) + queryString %>"
                class="inline-flex items-center gap-1 rounded-lg border px-3 py-1.5 text-xs font-semibold transition-colors <%= pagination.hasPreviousPage ? 'border-slate-300 bg-white text-slate-700 hover:bg-slate-50' : 'pointer-events-none border-slate-100 bg-slate-50 text-slate-300' %>"
              >
                Prev
              </a>
              <% for (let i = 1; i <= pagination.totalPages; i++) { %>
              <a
                href="<%= (i === 1 ? '/admin/dashboard' : '/admin/dashboard/page/' + i) + queryString %>"
                class="inline-flex h-8 min-w-8 items-center justify-center rounded-lg border px-2 text-xs font-semibold transition-colors <%= i === pagination.currentPage ? 'pointer-events-none border-brand-500 bg-brand-500 text-white' : 'border-slate-300 bg-white text-slate-700 hover:bg-slate-50' %>"
              >
                <%= i %>
              </a>
              <% } %>
              <a
                href="/admin/dashboard/page/<%= pagination.currentPage + 1 %><%= queryString %>"
                class="inline-flex items-center gap-1 rounded-lg border px-3 py-1.5 text-xs font-semibold transition-colors <%= pagination.hasNextPage ? 'border-slate-300 bg-white text-slate-700 hover:bg-slate-50' : 'pointer-events-none border-slate-100 bg-slate-50 text-slate-300' %>"
              >
                Next
              </a>
            </div>
          </nav>
          <% } %>

          <div
            id="empty-state-message"
            class="flex flex-col items-center justify-center py-24 <% if (totalProducts > 0) { %>hidden<% } %>"
          >
            <div
              class="w-14 h-14 rounded-2xl bg-slate-100 flex items-center justify-center mb-4"
            >
              <svg
                class="w-7 h-7 text-slate-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                />
              </svg>
            </div>
            <h3 class="text-base font-semibold text-slate-800">
              No products yet
            </h3>
            <p class="text-sm text-slate-500 mt-1 mb-5">
              Add your first digital product to get started.
            </p>
            <a
              href="/admin/products/add"
              class="inline-flex items-center gap-2 px-4 py-2 bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold rounded-lg transition-colors duration-150"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 4.5v15m7.5-7.5h-15"
                />
              </svg>
              Add Product
            </a>
          </div>
        </main>
      </div>
    </div>

    <script src="/js/admin-dashboard.js"></script>
  </body>
</html>
