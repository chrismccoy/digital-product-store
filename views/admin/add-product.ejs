<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add Product — Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link href="/css/app.css" rel="stylesheet" />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased">
    <div class="flex min-h-screen">

      <%- include('partials/sidebar') %>

      <div class="flex-1 flex flex-col min-w-0">
        <header
          class="h-16 bg-white border-b border-slate-200 flex items-center gap-4 px-6 shrink-0"
        >
          <a
            href="/admin/dashboard"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-slate-900 transition-colors"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"
              />
            </svg>
            Back
          </a>
          <span class="text-slate-300">/</span>
          <h1 class="text-base font-semibold text-slate-900">Add Product</h1>
        </header>

        <main class="flex-1 p-6">
          <div class="max-w-3xl mx-auto">
            <div
              id="form-error-message"
              class="hidden mb-5 flex items-start gap-3 rounded-lg border border-red-200 bg-red-50 p-4"
            ></div>

            <div
              class="bg-white rounded-xl border border-slate-200 shadow-card overflow-hidden"
            >
              <div class="px-6 py-4 border-b border-slate-100">
                <h2 class="text-sm font-semibold text-slate-900">
                  Product Details
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                  Fill in the information below to create a new product.
                </p>
              </div>

              <form
                id="product-form"
                enctype="multipart/form-data"
                class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-5"
              >
                <div>
                  <label
                    for="name"
                    class="block text-sm font-medium text-slate-700 mb-1.5"
                  >
                    Product Name <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    name="name"
                    id="name"
                    placeholder="e.g. UI Kit Pro"
                    class="w-full px-3.5 py-2.5 text-sm text-slate-900 bg-white border border-slate-300 rounded-lg shadow-input placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition"
                    required
                  />
                </div>

                <div>
                  <label
                    for="price"
                    class="block text-sm font-medium text-slate-700 mb-1.5"
                  >
                    Price <span class="text-red-500">*</span>
                  </label>
                  <div class="relative">
                    <span
                      class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400 text-sm pointer-events-none"
                    >$</span>
                    <input
                      type="number"
                      step="0.01"
                      name="price"
                      id="price"
                      placeholder="0.00"
                      class="w-full pl-7 pr-3.5 py-2.5 text-sm text-slate-900 bg-white border border-slate-300 rounded-lg shadow-input placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition"
                      required
                    />
                  </div>
                </div>

                <div>
                  <label
                    for="text"
                    class="block text-sm font-medium text-slate-700 mb-1.5"
                  >
                    Short Text
                  </label>
                  <input
                    type="text"
                    name="text"
                    id="text"
                    placeholder="Brief tagline or subtitle"
                    class="w-full px-3.5 py-2.5 text-sm text-slate-900 bg-white border border-slate-300 rounded-lg shadow-input placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition"
                  />
                </div>

                <div>
                  <label
                    for="productfile-input"
                    class="block text-sm font-medium text-slate-700 mb-1.5"
                  >
                    Product File
                  </label>
                  <input
                    type="file"
                    name="productfile"
                    id="productfile-input"
                    class="w-full text-sm text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-brand-50 file:text-brand-600 hover:file:bg-brand-100 border border-slate-300 rounded-lg px-2 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500 transition"
                  />
                </div>

                <div class="sm:col-span-2">
                  <label
                    for="service_message"
                    class="block text-sm font-medium text-slate-700 mb-1.5"
                  >
                    No-file message <span class="text-slate-400 font-normal">(for products without a file, e.g. a service)</span>
                  </label>
                  <textarea
                    name="service_message"
                    id="service_message"
                    rows="3"
                    placeholder="e.g. This is a custom service — no file to download. We'll reach out within 12 hours."
                    class="w-full px-3.5 py-2.5 text-sm text-slate-900 bg-white border border-slate-300 rounded-lg shadow-input placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition resize-none"
                  ></textarea>
                  <p class="text-xs text-slate-400 mt-1.5">Shown on the success page instead of a download button when the product has no file.</p>
                </div>

                <div class="sm:col-span-2">
                  <label
                    for="image-input"
                    class="block text-sm font-medium text-slate-700 mb-1.5"
                  >
                    Thumbnail Image
                  </label>
                  <img
                    id="image-preview"
                    src=""
                    alt="Thumbnail preview"
                    class="hidden mb-3 h-24 w-auto rounded-lg border border-slate-200 object-cover"
                  />
                  <input
                    type="file"
                    name="image"
                    id="image-input"
                    accept="image/*"
                    class="w-full text-sm text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-brand-50 file:text-brand-600 hover:file:bg-brand-100 border border-slate-300 rounded-lg px-2 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500 transition"
                  />
                </div>

                <div class="sm:col-span-2">
                  <label
                    for="description"
                    class="block text-sm font-medium text-slate-700 mb-1.5"
                  >
                    Description
                  </label>
                  <textarea
                    name="description"
                    id="description"
                    rows="4"
                    placeholder="Describe your product..."
                    class="w-full px-3.5 py-2.5 text-sm text-slate-900 bg-white border border-slate-300 rounded-lg shadow-input placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition resize-none"
                  ></textarea>
                </div>

                <div>
                  <label for="category_id" class="block text-sm font-medium text-slate-700 mb-1.5">
                    Category
                  </label>
                  <select
                    name="category_id"
                    id="category_id"
                    class="w-full px-3.5 py-2.5 text-sm text-slate-900 bg-white border border-slate-300 rounded-lg shadow-input focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition"
                  >
                    <option value="">— Uncategorized —</option>
                    <% categories.forEach(function (cat) { %>
                      <option value="<%= cat.id %>"><%= cat.name %></option>
                    <% }); %>
                  </select>
                </div>

                <div class="sm:col-span-2" data-tag-input-wrap>
                  <label for="tag-input-field" class="block text-sm font-medium text-slate-700 mb-1.5">
                    Tags <span class="text-slate-400 font-normal">(press comma or Enter after each)</span>
                  </label>
                  <input type="hidden" name="tags" value="<%= tagsValue %>" />
                  <div class="flex flex-wrap items-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2 focus-within:ring-2 focus-within:ring-brand-500">
                    <span data-tag-chips class="contents"></span>
                    <input
                      type="text"
                      id="tag-input-field"
                      data-tag-input
                      placeholder="e.g. web, tailwind"
                      class="flex-1 min-w-[8rem] border-0 p-0 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-0"
                    />
                  </div>
                </div>

                <div>
                  <label for="site_url" class="block text-sm font-medium text-slate-700 mb-1.5">
                    Site URL <span class="text-slate-400 font-normal">(optional)</span>
                  </label>
                  <input
                    type="url"
                    name="site_url"
                    id="site_url"
                    value=""
                    placeholder="https://example.com"
                    class="w-full px-3.5 py-2.5 text-sm text-slate-900 bg-white border border-slate-300 rounded-lg shadow-input placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition"
                  />
                </div>

                <div>
                  <label for="live_demo" class="block text-sm font-medium text-slate-700 mb-1.5">
                    Live Demo URL <span class="text-slate-400 font-normal">(optional)</span>
                  </label>
                  <input
                    type="url"
                    name="live_demo"
                    id="live_demo"
                    value=""
                    placeholder="https://demo.example.com"
                    class="w-full px-3.5 py-2.5 text-sm text-slate-900 bg-white border border-slate-300 rounded-lg shadow-input placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition"
                  />
                </div>

                <div class="sm:col-span-2">
                  <label for="gallery-input" class="block text-sm font-medium text-slate-700 mb-1.5">
                    Screenshots <span class="text-slate-400 font-normal">(optional, up to 10)</span>
                  </label>
                  <% if (galleryImages && galleryImages.length) { %>
                  <div class="mb-3 grid grid-cols-3 sm:grid-cols-4 gap-3">
                    <% galleryImages.forEach(function (img) { %>
                    <label class="relative block cursor-pointer group">
                      <img src="<%= img.path %>" alt="Screenshot" class="h-24 w-full rounded-lg border border-slate-200 object-cover" />
                      <span class="absolute inset-0 rounded-lg bg-black/0 group-has-[:checked]:bg-black/50 transition-colors"></span>
                      <span class="absolute top-1 right-1 flex items-center gap-1 rounded bg-white/90 px-1.5 py-0.5 text-[11px] font-semibold text-red-600">
                        <input type="checkbox" name="delete_images" value="<%= img.id %>" class="h-3 w-3 rounded border-slate-300 text-red-500 focus:ring-red-500" />
                        Remove
                      </span>
                    </label>
                    <% }); %>
                  </div>
                  <% } %>
                  <input
                    type="file"
                    name="gallery"
                    id="gallery-input"
                    accept="image/*"
                    multiple
                    class="w-full text-sm text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-brand-50 file:text-brand-600 hover:file:bg-brand-100 border border-slate-300 rounded-lg px-2 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500 transition"
                  />
                  <p class="text-xs text-slate-400 mt-1.5">Screenshots appear in a gallery with a lightbox on the product page.</p>
                </div>

                <div class="sm:col-span-2">
                  <label class="flex items-start gap-3 cursor-pointer">
                    <input
                      type="checkbox"
                      name="sticky"
                      value="1"
                      class="mt-0.5 h-4 w-4 rounded border-slate-300 text-brand-500 focus:ring-brand-500"
                    />
                    <span>
                      <span class="block text-sm font-medium text-slate-700">Sticky (feature this product)</span>
                      <span class="block text-xs text-slate-500 mt-0.5">Pins this product to the top of the shop grid.</span>
                    </span>
                  </label>
                </div>

                <div class="sm:col-span-2">
                  <label class="flex items-start gap-3 cursor-pointer">
                    <input
                      type="checkbox"
                      name="noindex"
                      value="1"
                      class="mt-0.5 h-4 w-4 rounded border-slate-300 text-brand-500 focus:ring-brand-500"
                    />
                    <span>
                      <span class="block text-sm font-medium text-slate-700">Private (unlisted)</span>
                      <span class="block text-xs text-slate-500 mt-0.5">Hides this product from the shop grid, category and tag pages, and the sitemap, and asks search engines not to list it. It stays reachable only by its direct link, so you can share a private product URL.</span>
                    </span>
                  </label>
                </div>

                <div class="sm:col-span-2 flex items-center justify-end gap-3 pt-1">
                  <a
                    href="/admin/dashboard"
                    class="px-4 py-2.5 text-sm font-semibold text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors duration-150"
                  >
                    Cancel
                  </a>
                  <button
                    type="submit"
                    id="form-submit-btn"
                    class="px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold rounded-lg shadow-sm transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2"
                  >
                    Add Product
                  </button>
                </div>
              </form>
            </div>
          </div>
        </main>
      </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("product-form");
        const formErrorMessage = document.getElementById("form-error-message");
        const imageInput = document.getElementById("image-input");
        const imagePreview = document.getElementById("image-preview");

        imageInput?.addEventListener("change", (e) => {
          const file = e.target.files[0];
          if (file) {
            imagePreview.src = URL.createObjectURL(file);
            imagePreview.classList.remove("hidden");
          }
        });

        form?.addEventListener("submit", async (event) => {
          event.preventDefault();
          formErrorMessage.classList.add("hidden");

          const formData = new FormData(form);
          if (
            !formData.get("name")?.trim() ||
            !formData.get("price")?.trim()
          ) {
            showError("Product Name and Price are required.");
            return;
          }

          try {
            const response = await fetch("/admin/api/products", {
              method: "POST",
              body: formData,
            });
            const result = await response.json();
            if (result.success) {
              window.location.href = `/admin/dashboard?saved=${encodeURIComponent(result.product.name)}`;
            } else {
              showError(result.message || "Could not save product.");
            }
          } catch (error) {
            showError("An unexpected network error occurred.");
          }
        });

        function showError(message) {
          formErrorMessage.innerHTML = `
            <svg class="w-4 h-4 text-red-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
            <p class="text-sm text-red-700">${message}</p>
          `;
          formErrorMessage.classList.remove("hidden");
        }
      });
    </script>
    <script src="/js/tag-input.js"></script>
  </body>
</html>
