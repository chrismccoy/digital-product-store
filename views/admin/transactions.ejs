<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Transactions — Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link href="/css/app.css" rel="stylesheet" />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased">
    <div class="flex min-h-screen">

      <%- include('partials/sidebar', { activeNav: 'transactions' }) %>

      <div class="flex-1 flex flex-col min-w-0">
        <header
          class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 shrink-0"
        >
          <div>
            <h1 class="text-base font-semibold text-slate-900">Transactions</h1>
            <p class="text-xs text-slate-500">Every completed purchase</p>
          </div>
          <form action="/admin/transactions" method="GET" class="flex items-center gap-2">
            <input
              type="text"
              name="q"
              value="<%= query %>"
              placeholder="Search email, name, product, ID"
              class="w-56 sm:w-72 px-3.5 py-2 text-sm text-slate-900 bg-white border border-slate-300 rounded-lg shadow-input focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition"
            />
            <button
              type="submit"
              class="px-4 py-2 bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold rounded-lg shadow-sm transition-colors duration-150"
            >
              Search
            </button>
            <% if (query) { %>
            <a href="/admin/transactions" class="px-3 py-2 text-sm font-medium text-slate-500 hover:text-slate-700">Clear</a>
            <% } %>
          </form>
        </header>

        <main class="flex-1 p-6">

          <div
            class="bg-white rounded-xl border border-slate-200 shadow-card overflow-hidden <% if (transactions.length === 0) { %>hidden<% } %>"
          >
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
              <h2 class="text-sm font-semibold text-slate-900">
                <%= query ? 'Search Results' : 'All Transactions' %>
                <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600">
                  <%= total %>
                </span>
              </h2>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead>
                  <tr class="border-b border-slate-100">
                    <th class="px-6 py-3 text-xs font-semibold uppercase tracking-wider text-slate-400">Date</th>
                    <th class="px-6 py-3 text-xs font-semibold uppercase tracking-wider text-slate-400">Product</th>
                    <th class="px-6 py-3 text-xs font-semibold uppercase tracking-wider text-slate-400">Buyer</th>
                    <th class="px-6 py-3 text-xs font-semibold uppercase tracking-wider text-slate-400">Amount</th>
                    <th class="px-6 py-3 text-xs font-semibold uppercase tracking-wider text-slate-400">Transaction ID</th>
                    <th class="px-6 py-3 text-xs font-semibold uppercase tracking-wider text-slate-400"><span class="sr-only">View</span></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                  <% transactions.forEach(tx => { %>
                  <tr class="hover:bg-slate-50 transition-colors duration-150">
                    <td class="px-6 py-4 text-sm text-slate-500 whitespace-nowrap">
                      <%= new Date(tx.purchaseDate).toLocaleString() %>
                    </td>
                    <td class="px-6 py-4">
                      <span class="text-sm font-semibold text-slate-800"><%= tx.product.name %></span>
                    </td>
                    <td class="px-6 py-4">
                      <span class="block text-sm text-slate-800"><%= tx.payer.firstName %> <%= tx.payer.lastName %></span>
                      <span class="block text-xs text-slate-500"><%= tx.payer.email %></span>
                    </td>
                    <td class="px-6 py-4 text-sm font-medium text-slate-700 whitespace-nowrap">
                      $<%= tx.product.price %>
                    </td>
                    <td class="px-6 py-4">
                      <span class="text-xs font-mono text-slate-500"><%= tx.id %></span>
                    </td>
                    <td class="px-6 py-4 text-right">
                      <a
                        href="/admin/transactions/<%= encodeURIComponent(tx.id) %>"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-brand-600 bg-brand-50 hover:bg-brand-100 rounded-md transition-colors duration-150"
                      >
                        View
                      </a>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>

          <% if (pagination.totalPages > 1) { %>
          <nav class="mt-6 flex items-center justify-between gap-4" aria-label="Pagination">
            <p class="text-xs text-slate-500">
              Page <%= pagination.currentPage %> of <%= pagination.totalPages %>
              <span class="mx-1">·</span><%= total %> transactions
            </p>
            <div class="flex items-center gap-1.5">
              <% const prevPage = pagination.currentPage - 1; %>
              <a
                href="<%= (prevPage <= 1 ? '/admin/transactions' : '/admin/transactions/page/' + prevPage) + queryString %>"
                class="inline-flex items-center gap-1 rounded-lg border px-3 py-1.5 text-xs font-semibold transition-colors <%= pagination.hasPreviousPage ? 'border-slate-300 bg-white text-slate-700 hover:bg-slate-50' : 'pointer-events-none border-slate-100 bg-slate-50 text-slate-300' %>"
              >
                Prev
              </a>
              <% for (let i = 1; i <= pagination.totalPages; i++) { %>
              <a
                href="<%= (i === 1 ? '/admin/transactions' : '/admin/transactions/page/' + i) + queryString %>"
                class="inline-flex h-8 min-w-8 items-center justify-center rounded-lg border px-2 text-xs font-semibold transition-colors <%= i === pagination.currentPage ? 'pointer-events-none border-brand-500 bg-brand-500 text-white' : 'border-slate-300 bg-white text-slate-700 hover:bg-slate-50' %>"
              >
                <%= i %>
              </a>
              <% } %>
              <a
                href="/admin/transactions/page/<%= pagination.currentPage + 1 %><%= queryString %>"
                class="inline-flex items-center gap-1 rounded-lg border px-3 py-1.5 text-xs font-semibold transition-colors <%= pagination.hasNextPage ? 'border-slate-300 bg-white text-slate-700 hover:bg-slate-50' : 'pointer-events-none border-slate-100 bg-slate-50 text-slate-300' %>"
              >
                Next
              </a>
            </div>
          </nav>
          <% } %>

          <% if (transactions.length === 0) { %>
          <div class="flex flex-col items-center justify-center py-24">
            <div class="w-14 h-14 rounded-2xl bg-slate-100 flex items-center justify-center mb-4">
              <svg class="w-7 h-7 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
              </svg>
            </div>
            <p class="text-sm font-semibold text-slate-700">
              <%= query ? 'No transactions match your search' : 'No transactions yet' %>
            </p>
            <p class="text-sm text-slate-500 mt-1">
              <%= query ? 'Try a different email, name, product, or ID.' : 'Completed purchases will appear here.' %>
            </p>
          </div>
          <% } %>

        </main>
      </div>
    </div>
  </body>
</html>
