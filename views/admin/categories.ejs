<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Categories — Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="/css/app.css" rel="stylesheet" />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased">
    <div class="flex min-h-screen">

      <%- include('partials/sidebar', { activeNav: 'categories' }) %>

      <div class="flex-1 flex flex-col min-w-0">
        <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 shrink-0">
          <div>
            <h1 class="text-base font-semibold text-slate-900">Categories</h1>
            <p class="text-xs text-slate-500">Group products and power the shop filter</p>
          </div>
        </header>

        <main class="flex-1 p-6">
          <div class="max-w-3xl mx-auto space-y-6">

            <div id="toast-notification" class="fixed top-5 right-5 z-50 w-full max-w-sm hidden" role="alert">
              <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-slate-200 shadow-card">
                <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                </div>
                <div class="flex-1 min-w-0 pt-0.5">
                  <p class="text-sm font-semibold text-slate-900">Done</p>
                  <p id="toast-message" class="text-sm text-slate-500 truncate"></p>
                </div>
              </div>
            </div>

            <div class="bg-white rounded-xl border border-slate-200 shadow-card overflow-hidden">
              <div class="px-6 py-4 border-b border-slate-100">
                <h2 class="text-sm font-semibold text-slate-900">Add category</h2>
              </div>
              <form id="add-category-form" class="p-6 flex items-end gap-3">
                <div class="flex-1">
                  <label for="category-name" class="block text-sm font-medium text-slate-700 mb-1.5">Name</label>
                  <input type="text" id="category-name" name="name" placeholder="e.g. Templates" required
                    class="w-full px-3.5 py-2.5 text-sm text-slate-900 bg-white border border-slate-300 rounded-lg shadow-input placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition" />
                </div>
                <button type="submit" class="px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold rounded-lg shadow-sm transition-colors duration-150">
                  Add
                </button>
              </form>
            </div>

            <div id="categories-view" class="bg-white rounded-xl border border-slate-200 shadow-card overflow-hidden <% if (categories.length === 0) { %>hidden<% } %>">
              <div class="px-6 py-4 border-b border-slate-100">
                <h2 class="text-sm font-semibold text-slate-900">All categories
                  <span id="category-count" class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600"><%= categories.length %></span>
                </h2>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full text-left">
                  <thead>
                    <tr class="border-b border-slate-100">
                      <th class="px-6 py-3 text-xs font-semibold uppercase tracking-wider text-slate-400">Name</th>
                      <th class="px-6 py-3 text-xs font-semibold uppercase tracking-wider text-slate-400">Products</th>
                      <th class="px-6 py-3 text-xs font-semibold uppercase tracking-wider text-slate-400">Actions</th>
                    </tr>
                  </thead>
                  <tbody id="categories-body" class="divide-y divide-slate-50">
                    <% categories.forEach(function (cat) { %>
                    <tr data-id="<%= cat.id %>" class="group border-b border-slate-100 hover:bg-slate-50 transition-colors duration-150">
                      <td class="px-6 py-4">
                        <span class="category-name font-semibold text-slate-800 text-sm"><%= cat.name %></span>
                      </td>
                      <td class="px-6 py-4">
                        <span class="category-count inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600"><%= cat.productCount %></span>
                      </td>
                      <td class="px-6 py-4">
                        <div class="flex items-center gap-2">
                          <button type="button" class="edit-btn inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-brand-600 bg-brand-50 hover:bg-brand-100 rounded-md transition-colors duration-150">Edit</button>
                          <button type="button" class="delete-btn inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-red-600 bg-red-50 hover:bg-red-100 rounded-md transition-colors duration-150">Delete</button>
                        </div>
                      </td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </div>

            <div id="empty-state" class="flex flex-col items-center justify-center py-16 <% if (categories.length > 0) { %>hidden<% } %>">
              <h3 class="text-base font-semibold text-slate-800">No categories yet</h3>
              <p class="text-sm text-slate-500 mt-1">Add one above to start grouping products.</p>
            </div>
          </div>
        </main>
      </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const body = document.getElementById("categories-body");
        const view = document.getElementById("categories-view");
        const empty = document.getElementById("empty-state");
        const countBadge = document.getElementById("category-count");
        const addForm = document.getElementById("add-category-form");
        const nameInput = document.getElementById("category-name");
        const toast = document.getElementById("toast-notification");
        const toastMessage = document.getElementById("toast-message");
        let toastTimer;

        const showToast = (m) => {
          clearTimeout(toastTimer);
          toastMessage.textContent = m || "";
          toast.classList.remove("hidden");
          toastTimer = setTimeout(() => toast.classList.add("hidden"), 3500);
        };
        const esc = (s) => s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
        const refreshState = () => {
          const has = body.querySelectorAll("tr").length > 0;
          view.classList.toggle("hidden", !has);
          empty.classList.toggle("hidden", has);
          countBadge.textContent = body.querySelectorAll("tr").length;
        };

        const rowHTML = (cat) => `
          <tr data-id="${cat.id}" class="group border-b border-slate-100 hover:bg-slate-50 transition-colors duration-150">
            <td class="px-6 py-4"><span class="category-name font-semibold text-slate-800 text-sm">${esc(cat.name)}</span></td>
            <td class="px-6 py-4"><span class="category-count inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600">0</span></td>
            <td class="px-6 py-4"><div class="flex items-center gap-2">
              <button type="button" class="edit-btn inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-brand-600 bg-brand-50 hover:bg-brand-100 rounded-md transition-colors duration-150">Edit</button>
              <button type="button" class="delete-btn inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-red-600 bg-red-50 hover:bg-red-100 rounded-md transition-colors duration-150">Delete</button>
            </div></td>
          </tr>`;

        addForm.addEventListener("submit", async (e) => {
          e.preventDefault();
          const name = nameInput.value.trim();
          if (!name) return;
          try {
            const r = await fetch("/admin/api/categories", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ name }),
            });
            const result = await r.json();
            if (result.success) {
              body.insertAdjacentHTML("afterbegin", rowHTML(result.category));
              nameInput.value = "";
              refreshState();
              showToast(`Added "${result.category.name}".`);
            } else {
              showToast(result.message || "Could not add category.");
            }
          } catch (_) {
            showToast("Network error.");
          }
        });

        body.addEventListener("click", async (e) => {
          const row = e.target.closest("tr");
          if (!row) return;
          const id = row.dataset.id;
          const nameCell = row.querySelector(".category-name");

          if (e.target.matches(".edit-btn")) {
            const current = nameCell.textContent;
            const input = document.createElement("input");
            input.type = "text";
            input.value = current;
            input.className = "w-full px-2 py-1 text-sm border border-brand-300 rounded focus:outline-none focus:ring-2 focus:ring-brand-500";
            nameCell.replaceWith(input);
            input.focus();
            const save = async () => {
              const newName = input.value.trim();
              if (!newName || newName === current) { restore(current); return; }
              try {
                const r = await fetch(`/admin/api/categories/${id}`, {
                  method: "PUT",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ name: newName }),
                });
                const result = await r.json();
                if (result.success) { restore(result.category.name); showToast("Renamed."); }
                else { restore(current); showToast(result.message || "Could not rename."); }
              } catch (_) { restore(current); showToast("Network error."); }
            };
            const restore = (val) => {
              const span = document.createElement("span");
              span.className = "category-name font-semibold text-slate-800 text-sm";
              span.textContent = val;
              input.replaceWith(span);
            };
            input.addEventListener("blur", save);
            input.addEventListener("keydown", (ev) => {
              if (ev.key === "Enter") { ev.preventDefault(); input.blur(); }
              if (ev.key === "Escape") { restore(current); }
            });
          } else if (e.target.matches(".delete-btn")) {
            const cell = e.target.closest("td");
            cell.innerHTML = `<div class="flex items-center gap-2">
              <span class="text-xs text-slate-600 font-medium">Delete? Products become uncategorized.</span>
              <button type="button" class="confirm-del inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-red-600 bg-red-50 hover:bg-red-100 rounded-md">Yes</button>
              <button type="button" class="cancel-del inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-md">No</button>
            </div>`;
          } else if (e.target.matches(".cancel-del")) {
            e.target.closest("td").innerHTML = `<div class="flex items-center gap-2">
              <button type="button" class="edit-btn inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-brand-600 bg-brand-50 hover:bg-brand-100 rounded-md transition-colors duration-150">Edit</button>
              <button type="button" class="delete-btn inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-red-600 bg-red-50 hover:bg-red-100 rounded-md transition-colors duration-150">Delete</button>
            </div>`;
          } else if (e.target.matches(".confirm-del")) {
            try {
              const r = await fetch(`/admin/api/categories/${id}`, { method: "DELETE" });
              const result = await r.json();
              if (result.success) { row.remove(); refreshState(); showToast("Category deleted."); }
              else { showToast(result.message || "Could not delete."); }
            } catch (_) { showToast("Network error."); }
          }
        });

        refreshState();
      });
    </script>
  </body>
</html>
