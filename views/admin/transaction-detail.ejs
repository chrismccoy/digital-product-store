<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Transaction — Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link href="/css/app.css" rel="stylesheet" />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased">
    <div class="flex min-h-screen">

      <%- include('partials/sidebar', { activeNav: 'transactions' }) %>

      <div class="flex-1 flex flex-col min-w-0">
        <header
          class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 shrink-0"
        >
          <div>
            <h1 class="text-base font-semibold text-slate-900">Transaction</h1>
            <p class="text-xs text-slate-500">Full purchase details</p>
          </div>
          <a
            href="/admin/transactions"
            class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-sm font-semibold rounded-lg shadow-sm transition-colors duration-150"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 5l-7 7 7 7" />
            </svg>
            Back to Transactions
          </a>
        </header>

        <main class="flex-1 p-6">
          <div class="max-w-3xl mx-auto">

            <% if (!transaction) { %>
            <div class="bg-white rounded-xl border border-slate-200 shadow-card p-10 text-center">
              <p class="text-sm font-semibold text-slate-800">Transaction not found</p>
              <p class="text-sm text-slate-500 mt-1">No purchase matches that ID.</p>
              <a href="/admin/transactions" class="inline-flex mt-4 text-sm font-semibold text-brand-600 hover:text-brand-700">Back to Transactions</a>
            </div>
            <% } else { %>

            <div class="bg-white rounded-xl border border-slate-200 shadow-card overflow-hidden">
              <div class="px-6 py-5 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3">
                <div>
                  <p class="text-sm font-semibold text-slate-900"><%= transaction.product.name %></p>
                  <p class="text-xs text-slate-500 mt-0.5"><%= new Date(transaction.purchaseDate).toLocaleString() %></p>
                </div>
                <span class="text-2xl font-bold text-slate-900">$<%= transaction.product.price %></span>
              </div>

              <dl class="divide-y divide-slate-100">
                <div class="px-6 py-4 grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-4">
                  <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">Transaction ID</dt>
                  <dd class="sm:col-span-2 text-sm font-mono text-slate-800 break-all"><%= transaction.id %></dd>
                </div>
                <div class="px-6 py-4 grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-4">
                  <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">Order ID</dt>
                  <dd class="sm:col-span-2 text-sm font-mono text-slate-800 break-all"><%= transaction.orderId %></dd>
                </div>
                <div class="px-6 py-4 grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-4">
                  <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">Purchase Date</dt>
                  <dd class="sm:col-span-2 text-sm text-slate-800"><%= new Date(transaction.purchaseDate).toLocaleString() %></dd>
                </div>
                <div class="px-6 py-4 grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-4">
                  <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">Product</dt>
                  <dd class="sm:col-span-2 text-sm text-slate-800">
                    <%= transaction.product.name %>
                    <% if (product) { %>
                      <a href="/product/<%= transaction.product.id %>" target="_blank" rel="noopener" class="ml-2 text-xs font-semibold text-brand-600 hover:text-brand-700">View product</a>
                    <% } else { %>
                      <span class="ml-2 text-xs text-slate-400">(product no longer exists)</span>
                    <% } %>
                  </dd>
                </div>
                <div class="px-6 py-4 grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-4">
                  <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">Amount Paid</dt>
                  <dd class="sm:col-span-2 text-sm text-slate-800">$<%= transaction.product.price %> USD</dd>
                </div>
                <div class="px-6 py-4 grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-4">
                  <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">Buyer</dt>
                  <dd class="sm:col-span-2 text-sm text-slate-800"><%= transaction.payer.firstName %> <%= transaction.payer.lastName %></dd>
                </div>
                <div class="px-6 py-4 grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-4">
                  <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">Email</dt>
                  <dd class="sm:col-span-2 text-sm text-slate-800 break-all">
                    <a href="mailto:<%= transaction.payer.email %>" class="text-brand-600 hover:text-brand-700"><%= transaction.payer.email %></a>
                  </dd>
                </div>
                <div class="px-6 py-4 grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-4">
                  <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">Receipt Email</dt>
                  <dd class="sm:col-span-2 text-sm text-slate-800 flex flex-wrap items-center gap-3">
                    <span id="receiptStatus" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold <%= transaction.emailSent ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700' %>">
                      <%= transaction.emailSent ? 'Sent' : 'Not sent' %>
                    </span>
                    <button
                      id="resendBtn"
                      data-id="<%= transaction.id %>"
                      class="inline-flex items-center px-3 py-1.5 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-lg shadow-sm transition-colors duration-150 disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                      Resend receipt
                    </button>
                  </dd>
                </div>
              </dl>
            </div>

            <% } %>
          </div>
        </main>
      </div>
    </div>

    <% if (transaction) { %>
    <script>
      (function () {
        var btn = document.getElementById("resendBtn");
        var status = document.getElementById("receiptStatus");
        if (!btn) return;

        btn.addEventListener("click", async function () {
          var id = btn.getAttribute("data-id");
          var original = btn.textContent;
          btn.disabled = true;
          btn.textContent = "Sending...";
          try {
            var res = await fetch(
              "/admin/transactions/" + encodeURIComponent(id) + "/resend",
              { method: "POST", headers: { "Content-Type": "application/json" } }
            );
            var data = await res.json();
            if (res.ok && data.success) {
              status.textContent = "Sent";
              status.className =
                "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700";
              btn.textContent = "Sent";
            } else {
              btn.textContent = original;
              btn.disabled = false;
              alert(data.message || "Could not resend the receipt.");
            }
          } catch (err) {
            btn.textContent = original;
            btn.disabled = false;
            alert("Could not resend the receipt.");
          }
        });
      })();
    </script>
    <% } %>
  </body>
</html>
