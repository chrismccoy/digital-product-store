<div class="relative flex min-h-screen flex-col overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 -z-10 animate-pulsegrid
           bg-grid bg-[size:42px_42px]"
  ></div>
  <div
    class="pointer-events-none absolute left-[8%] top-20 -z-10 h-56 w-56
           animate-float rounded-full bg-brand-500/20 blur-3xl"
  ></div>
  <div
    class="pointer-events-none absolute right-[10%] top-40 -z-10 h-72 w-72
           animate-float-slow rounded-full bg-fuchsia-500/15 blur-3xl"
  ></div>
  <div
    class="pointer-events-none absolute bottom-0 left-1/2 -z-10 h-80 w-80
           -translate-x-1/2 rounded-full bg-cyan-400/10 blur-3xl"
  ></div>

  <header class="relative z-10">
    <nav
      class="mx-auto flex max-w-7xl items-center justify-between
             px-6 py-6 lg:px-8"
    >
      <a
        href="<%= homeURL %>"
        class="inline-flex items-center gap-1.5 rounded-full border
               border-blue/20 bg-white px-5 py-2.5 text-sm font-semibold
               text-black shadow-md backdrop-blur-sm transition-all
               duration-200 hover:scale-[1.06] hover:bg-white
               hover:text-blue-700"
      >
        <%= headerNavLabel %>
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="transition-transform duration-200 group-hover:translate-x-0.5"
        >
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
        <%= homeText %>
      </a>
<% if (typeof currentPath === "undefined" || currentPath.replace(/\/$/, "") !== "/contact") { %>
      <a
        href="<%= contactURL %>"
        class="inline-flex items-center gap-1.5 rounded-full border
               border-blue/20 bg-white px-5 py-2.5 text-sm font-semibold
               text-black shadow-md backdrop-blur-sm transition-all
               duration-200 hover:scale-[1.06] hover:bg-white
               hover:text-blue-700"
      >
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 4h16v16H4z" />
          <path d="M4 4l8 8 8-8" />
        </svg>
        Contact
      </a>
<% } %>
    </nav>
  </header>
