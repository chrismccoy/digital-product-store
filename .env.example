# The port the application server will listen on.
PORT=3000

# Initial login for /admin/dashboard. Used only until you change
# the credentials from the admin Settings page; after that the password is
# stored as a salted hash in the database and these are ignored.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_this_password"

# A long, random, and secret string used to sign the session ID cookie.
SESSION_SECRET="generate-a-long-random-secure-string-for-this-12345-and-make-it-longer"

# Obtain these from your PayPal Developer Dashboard (https://developer.paypal.com/).
# Use sandbox credentials for testing and development.
PAYPAL_CLIENT_ID=YOUR_SANDBOX_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_PAYPAL_CLIENT_SECRET
PAYPAL_API_MODE=sandbox # Use 'live' for production

# Rate Limiting
# The time window for the rate limit in milliseconds.
AUTH_RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
# The maximum number of FAILED login attempts allowed per window.
AUTH_RATE_LIMIT_MAX=5

# Admin IP allowlist. Comma-separated list of IP addresses permitted to reach
# the /admin area. Leave EMPTY to allow any IP (the check is disabled).
# Example: ADMIN_IP_ALLOWLIST="203.0.113.7,198.51.100.22"
ADMIN_IP_ALLOWLIST=

# --- Advanced (optional) ---
# All of these have sensible built-in defaults. Uncomment and set only if you
# need to change them.

# Path to the SQLite database file. Default: db/store.db
# DB_PATH=db/store.db

# How long an admin login session stays valid, in milliseconds. Default: 86400000 (24 hours)
# SESSION_MAX_AGE_MS=86400000

# How long a one-time download link stays valid, in milliseconds. Default: 900000 (15 minutes)
# DOWNLOAD_GRANT_TTL_MS=900000

# Redownload verification rate limit: attempts allowed per window, per IP. Default: 10
# DOWNLOAD_RATE_LIMIT_MAX=10

# Redownload rate-limit window, in milliseconds. Default: 900000 (15 minutes)
# DOWNLOAD_RATE_LIMIT_WINDOW_MS=900000

# Largest allowed upload (product files, images), in bytes. Default: 524288000 (500 MB)
# UPLOAD_MAX_BYTES=524288000

